<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificates only (no user-added CAs). The code additionally refuses any host
     other than Harman's public file server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
