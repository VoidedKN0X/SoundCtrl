    <!-- Shell texts for this app -->
    <string name="settings_subtitle">Connecting and privacy</string>
    <string name="app_lock_subtitle">Ask for an app PIN (and optionally your fingerprint) when opening SoundCtrl. A firmware update that\'s running keeps going.</string>
    <string name="app_lock_footer">SoundCtrl has no analytics, tracking or account. It goes online only when you tap Check for update, and then only to Harman\'s public file server with your device\'s product id. Your device list stays on this phone.</string>
    <string name="lock_prompt_subtitle">Your JBL devices</string>
    <string name="lock_forgot_body">The PIN can\'t be recovered. SoundCtrl will forget its list of devices, reset its settings and turn the app lock off. Nothing on your headphones or speakers changes.</string>

