    <string name="file_check">Check file</string>
    <string name="file_unreadable">Couldn\'t read that file</string>
    <string name="install">Install</string>
    <string name="sending">Sending to the device… %1$d %%</string>
    <string name="sending_body">Keep the device on and close to the phone. You can stop; the device keeps what it has received and continues from there next time.</string>
    <string name="abort">Stop</string>
    <string name="update_done">Sent. The device installs the update and restarts by itself; this can take a few minutes. Then reconnect to see the new version.</string>
    <string name="update_cancelled">Stopped. The device keeps its current firmware.</string>
    <string name="failed_no_source">No update file is published for this model.</string>
    <string name="failed_network">Couldn\'t reach Harman\'s file server.</string>
    <string name="failed_answer">The server\'s answer couldn\'t be read.</string>
    <string name="failed_md5">The MD5 doesn\'t match: the file is damaged or not the one described. Nothing was sent to the device.</string>
    <string name="failed_transfer">The update stopped: %1$s</string>
    <string name="write_not_available">Update from this app isn\'t available for this model yet</string>
    <string name="write_not_available_body">SoundCtrl can read the firmware version and check Harman\'s server, but the way this chip family takes new firmware isn\'t fully established, so SoundCtrl doesn\'t send anything to it. Use the JBL app for this update.</string>
    <string name="block_not_newer">Only newer firmware can be installed.</string>
    <string name="block_unknown_version">The device\'s or the file\'s version couldn\'t be read, so SoundCtrl can\'t make sure the update is newer.</string>
    <string name="block_battery">Charge the device to at least %1$d %% first.</string>
    <string name="block_playing">Stop playing music first; the device must be idle.</string>
    <string name="block_grouped">Leave PartyBoost, Auracast or stereo first.</string>
    <string name="confirm_title">Install firmware %1$s?</string>
    <string name="confirm_body">Firmware writing in SoundCtrl has NOT been tested on a real device yet. It follows the update protocol of the JBL app as closely as it could be established, and the device checks the image before switching to it, but a failed update could leave the device needing JBL\'s app or service to recover. Continue only if you accept that risk.\n\nKeep the device on, charged and close to the phone until it finishes.</string>
    <string name="confirm_install">Install anyway</string>
