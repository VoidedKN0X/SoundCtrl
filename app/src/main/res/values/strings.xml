    <string name="settings_file_group">Settings file</string>
    <string name="settings_file_footer">Only SoundCtrl\'s settings are in the file: no devices, no Bluetooth addresses and nothing of the app lock. Importing can turn on Hide in screenshots and Hide in recent apps and shorten the lock time, but never turns them off or makes the lock wait longer.</string>
