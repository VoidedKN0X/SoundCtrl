    <!-- Update -->
    <string name="update_title">Firmware update</string>
    <string name="installed">Installed</string>
    <string name="check_update">Check for update</string>
    <string name="check_explain">One anonymous request to Harman\'s public file server (%1$s) with only the product id %2$s. Nothing else about you or the device is sent.</string>
    <string name="no_update_source">Harman\'s server has no update file for this model.</string>
    <string name="checking">Checking…</string>
    <string name="update_available">Version %1$s is available</string>
    <string name="update_not_newer">Version %1$s is on the server; it isn\'t newer than yours</string>
